rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;

      allow update: if (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['_reviewSum', '_reviewCount', 'avgRating', '_badgesCount'])
        && request.auth.uid != userId
        && request.resource.data._reviewCount is int
        && request.resource.data._reviewCount >= (resource.data._reviewCount || 0) - 1
        && request.resource.data._reviewCount <= (resource.data._reviewCount || 0) + 1
      );
    }

    match /users/{userId}/photos/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    match /activities/{activityId}/photos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /participations/{participationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && isValidParticipationId(participationId, request.resource.data.activityId, request.auth.uid);
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.activityOwnerId
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.activityOwnerId
      );
    }

    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidReviewCreate(request.resource.data, request.auth.uid);
      allow update: if request.auth != null && resource.data.reviewerId == request.auth.uid && isValidReviewUpdate(resource.data, request.resource.data);
      allow delete: if request.auth != null && resource.data.reviewerId == request.auth.uid;
    }

    function isValidReviewCreate(data, uid) {
      return data.reviewerId == uid
        && data.reviewedId is string
        && data.activityId is string
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.badges is list
        && data.badges.size() <= 5
        && (data.comment == null || data.comment is string);
    }

    function isValidReviewUpdate(oldData, newData) {
      return newData.reviewerId == oldData.reviewerId
        && newData.reviewedId == oldData.reviewedId
        && newData.activityId == oldData.activityId
        && newData.rating is int
        && newData.rating >= 1
        && newData.rating <= 5
        && newData.badges is list
        && newData.badges.size() <= 5
        && (newData.comment == null || newData.comment is string);
    }

    function isValidParticipationId(participationId, activityId, userId) {
      return participationId == 'p_' + activityId + '_' + userId;
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
    }
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/chats/$(chatId)) && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /interests/{interestId} {
      allow read: if request.auth != null;
    }
  }
}
